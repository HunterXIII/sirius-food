# Скопировать в .env и поменять SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://sirius:sirius@localhost:5672/
# True - локальная разработка (Swagger включён). В продакшене False.
DEBUG=True
ALLOWED_ORIGINS=["https://sirius-food.ru"]
