# Скопировать в .env и поменять SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://sirius:sirius@localhost:5672/
# True - локальная разработка (Swagger включён). В продакшене False.
DEBUG=True
ALLOWED_ORIGINS=["https://sirius-food.ru"]

# OpenRouter нужен для генерации ответов по меню и FAQ.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Compose использует эти настройки для базы и RabbitMQ.
POSTGRES_USER=sirius
POSTGRES_PASSWORD=sirius
POSTGRES_DB=sirius_food
RABBITMQ_DEFAULT_USER=sirius
RABBITMQ_DEFAULT_PASS=sirius
