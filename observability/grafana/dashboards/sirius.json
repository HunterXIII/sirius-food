{
  "uid": "sirius-food-lab9",
  "title": "Сириус.Еда — ЛР № 9",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Создание заказов · запросы/с",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "sirius-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(http_requests_total{handler=\"/orders/create\",method=\"POST\"}[$__rate_interval]))",
        "legendFormat": "POST /orders/create"
      }]
    },
    {
      "id": 2,
      "title": "Задержка меню p95",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "sirius-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/menu/items\",method=\"GET\"}[$__rate_interval])))",
        "legendFormat": "GET /menu/items"
      }]
    },
    {
      "id": 3,
      "title": "Ошибки API 5xx · ошибок/с",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "sirius-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(http_requests_total{status=\"5xx\"}[$__rate_interval])) or (0 * max(up{job=\"sirius_app\"} == 1))",
        "legendFormat": "5xx"
      }]
    },
    {
      "id": 4,
      "title": "Сообщения в очереди кухни",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "sirius-prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "rabbitmq_queue_messages{queue=\"kitchen_queue\",vhost=\"/\"}",
        "legendFormat": "{{queue}}"
      }]
    },
    {
      "id": 5,
      "title": "Попадания в кеш Redis",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "sirius-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [{
        "refId": "A",
        "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
        "legendFormat": "Доля попаданий"
      }]
    }
  ]
}
