{
  "uid": "sirius-food-lab10",
  "title": "Сириус.Еда — ЛР № 10",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP · запросов/с",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, handler) (rate(http_requests_total{handler=~\"/menu/items.*|/orders/create\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP · задержка p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, handler) (rate(http_request_duration_seconds_bucket{handler=~\"/menu/items.*|/orders/create\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP · 5xx/с",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) or (0 * max(up{job=\"sirius_app\"} == 1))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "Celery · задачи в очереди default",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_key_size{db=\"db0\",key=\"default\"} or (0 * max(redis_up == 1))",
          "legendFormat": "Ожидают выполнения"
        }
      ]
    },
    {
      "id": 5,
      "title": "API · загрузка одного ядра",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sirius-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"sirius_app\"}[$__rate_interval])",
          "legendFormat": "Uvicorn"
        }
      ]
    }
  ]
}
